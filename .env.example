# Copiez ce fichier en ".env" puis remplacez les valeurs ci-dessous.
#
# SECRET_KEY : clé secrète unique pour sécuriser les sessions.
#   Générez-en une avec :  python -c "import secrets; print(secrets.token_hex(32))"
#   puis collez le résultat à la place de la valeur ci-dessous.
SECRET_KEY=remplacez_moi_par_une_cle_generee

# DATABASE_URI : emplacement de la base SQLite. Laissez tel quel pour un fichier
#   "baluchon.db" dans le dossier de l'application.
DATABASE_URI=sqlite:///baluchon.db
